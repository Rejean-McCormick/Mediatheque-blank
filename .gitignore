# Instance locale : ne jamais versionner les bases, sources, preuves ou sauvegardes.
# Les .gitkeep sont les seuls fichiers autorises sous les dossiers de donnees.
/01_DB/**
!/01_DB/**/
!/01_DB/.gitkeep
!/01_DB/**/.gitkeep
/02_STORAGE/**
!/02_STORAGE/**/
!/02_STORAGE/.gitkeep
!/02_STORAGE/**/.gitkeep
/03_IMPORTS/**
!/03_IMPORTS/**/
!/03_IMPORTS/.gitkeep
!/03_IMPORTS/**/.gitkeep
/04_EXPORTS/**
!/04_EXPORTS/**/
!/04_EXPORTS/.gitkeep
!/04_EXPORTS/**/.gitkeep
/07_BACKUPS/**
!/07_BACKUPS/**/
!/07_BACKUPS/.gitkeep
!/07_BACKUPS/**/.gitkeep
/08_LOGS/**
!/08_LOGS/**/
!/08_LOGS/.gitkeep
!/08_LOGS/**/.gitkeep
/documents/**
!/documents/**/
!/documents/.gitkeep
!/documents/**/.gitkeep
/kristals/**
!/kristals/**/
!/kristals/.gitkeep
!/kristals/**/.gitkeep
